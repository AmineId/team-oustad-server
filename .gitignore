############################################
# Node/Express + Prisma .gitignore
############################################

# Dependencies
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# PM2 logs et pids
.pm2/
pids/

# Diagnostic reports
report.*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage
*.lcov
.nyc_output

# Build output
dist
build
out
.tmp
tmp
.temp

# TypeScript
*.tsbuildinfo

# Prisma
# Generated client lives in node_modules; keep schema and migrations tracked
# Ignore local SQLite databases (if using SQLite locally)
prisma/*.db
prisma/*.db-journal

# If you generate artifacts under this folder locally, keep them ignored
/generated/prisma

# Editors/IDEs
.vscode/
.idea/
*.iml
.history

# OS
.DS_Store
Thumbs.db

# Swap files
*.swp
*.swo

# Package manager stores
.pnpm-store

# Logs du serveur
server.log
*.log

# Fichiers temporaires
nohup.out

# Environment variables
.env
.env.local
.env.production
.env.test

# Ne pas commiter les fichiers .env spécifiques aux environnements (sauf .example)
.env.preprod
.env.prod

# Firebase credentials
firebase-service-account.json
firebase-service-account-preprod.json
firebase-service-account-prod.json
*-firebase-adminsdk-*.json

# Test data
test-results/
*.test.db

# Cache
.cache/
.parcel-cache/

# Cloudflare
.cloudflared/

google-services.json.env.ota-token
