# Environment: PREPROD
NODE_ENV=preprod

# Database - PostgreSQL Preprod
DATABASE_URL="postgresql://admin:admin@localhost:5433/fitness_preprod?schema=public"

# Server Configuration
PORT=3001
HOST=0.0.0.0

# JWT Secret - IMPORTANT: Utilisez un secret différent pour preprod
JWT_SECRET="preprod_replace_this_with_a_strong_secret"

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-application
FRONTEND_URL=https://preprod-app.votredomaine.com

# Firebase Cloud Messaging Configuration
# Pour activer les notifications push en preprod:
# 1. Allez sur https://console.firebase.google.com
# 2. Téléchargez la clé de service PREPROD (Project Settings > Service accounts > Generate new private key)
# 3. Renommez le fichier en "firebase-service-account-preprod.json"
# 4. Décommentez la ligne ci-dessous
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account-preprod.json
