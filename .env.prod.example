# Environment: PRODUCTION
NODE_ENV=production

# Database - PostgreSQL Production
# IMPORTANT: Changez cette URL pour pointer vers votre base de données production
DATABASE_URL="postgresql://user:password@prod-db-host:5432/fitness_prod?schema=public"

# Server Configuration
PORT=3002
HOST=0.0.0.0

# JWT Secret - IMPORTANT: Utilisez un secret FORT et UNIQUE pour production
JWT_SECRET="production_CHANGE_THIS_TO_A_VERY_STRONG_SECRET_KEY"

# Email Configuration (SMTP)
# IMPORTANT: Utilisez un service email professionnel en production (SendGrid, SES, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@votredomaine.com
SMTP_PASS=votre-mot-de-passe-securise
FRONTEND_URL=https://app.votredomaine.com

# Firebase Cloud Messaging Configuration
# Pour activer les notifications push en production:
# 1. Allez sur https://console.firebase.google.com
# 2. Téléchargez la clé de service PRODUCTION (Project Settings > Service accounts > Generate new private key)
# 3. Renommez le fichier en "firebase-service-account-prod.json"
# 4. Décommentez la ligne ci-dessous
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account-prod.json

# Email Configuration (si vous utilisez des emails en production)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=noreply@teamfitness.com
# EMAIL_PASSWORD=your_email_password
