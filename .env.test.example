# Test Environment
NODE_ENV=test

# Database - Test Database (use different port or DB name)
# For local testing with Docker: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=testpass -e POSTGRES_USER=testuser -e POSTGRES_DB=team_fitness_test postgres:14
DATABASE_URL="postgresql://testuser:testpass@localhost:5432/team_fitness_test"

# JWT Secret for testing
JWT_SECRET="test_jwt_secret_key_for_testing_purposes"

# SMTP Configuration (can be fake for tests as they're mocked)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="test"
SMTP_PASS="test"

# API URL for tests
API_URL="http://localhost:3000"
MOBILE_APP_LINK="https://play.google.com/store/apps/details?id=team.fitness.team_fitness_app"

# Firebase (optional for tests, as it's mocked)
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
