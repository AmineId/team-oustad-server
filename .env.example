# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://username:password@localhost:5432/team_fitness_db"

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET="your_super_secret_jwt_key_here"

# ============================================
# EMAIL CONFIGURATION (SMTP)
# ============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# URL du frontend pour les liens de réinitialisation
FRONTEND_URL="http://localhost:3000"

# ============================================
# FIREBASE CLOUD MESSAGING (Optional)
# ============================================
# Path to Firebase service account JSON file
# To enable push notifications:
# 1. Download your Firebase service account key from:
#    https://console.firebase.google.com > Project Settings > Service Accounts
# 2. Save it as "firebase-service-account.json" in the project root
# 3. Uncomment the line below and restart the server
# 
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ============================================
# SERVER
# ============================================
# PORT=3000
# HOST=0.0.0.0