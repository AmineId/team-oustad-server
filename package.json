{
  "name": "team_fitness_server",
  "version": "1.0.0",
  "description": "API REST complète pour la gestion des salles de sport avec système d'abonnements, paiements automatisés et notifications push",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "cross-env NODE_ENV=development nodemon -L --config config/nodemon.json",
    "dev:full": "npm run db:up && npm run dev",
    "start:preprod": "dotenv run -f .env.preprod -- node index.js",
    "start:prod": "dotenv run -f .env.prod -- node index.js",

    "db:up": "docker compose -f config/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f config/docker-compose.yml down",
    "db:seed": "node prisma/seed.js",
    "db:test:up": "docker compose -f config/docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f config/docker-compose.test.yml down",

    "migrate": "prisma migrate dev",
    "migrate:preprod": "dotenv run -f .env.preprod -- prisma migrate deploy",
    "migrate:prod": "dotenv run -f .env.prod -- prisma migrate deploy",
    "studio": "prisma studio",

    "preprod:full": "npm run db:preprod:up && npm run migrate:preprod && npm run start:preprod",
    "preprod:setup": "npm run db:preprod:up && npm run migrate:preprod && dotenv run -f .env.preprod -- node prisma/seed.js",
    "prod:deploy": "npm run migrate:prod && npm start",
    "db:preprod:up": "docker compose -f config/docker-compose-multi-env.yml up -d --wait postgres-preprod",
    "db:preprod:down": "docker compose -f config/docker-compose-multi-env.yml stop postgres-preprod",

    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --runInBand",
    "test:ci": "cross-env NODE_ENV=test jest --ci --coverage --runInBand",

    "tunnel": "./bin/start-tunnel.sh",
    "pm2:restart:preprod": "npx prisma generate && pm2 restart teamfitness-preprod"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "whatsapp-web.js": "^1.34.7",
    "winston": "^3.19.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@jest/globals": "^30.5.2",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.5.2",
    "jest-mock-extended": "^4.0.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
