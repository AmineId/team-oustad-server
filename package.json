{
  "name": "team_fitness_server",
  "version": "1.0.0",
  "description": "API REST complète pour la gestion des salles de sport avec système d'abonnements, paiements automatisés et notifications push",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon -L --config config/nodemon.json",
    "start:preprod": "NODE_ENV=preprod node -r dotenv/config index.js dotenv_config_path=.env.preprod",
    "start:prod": "NODE_ENV=production node -r dotenv/config index.js dotenv_config_path=.env.prod",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:preprod": "dotenv -e .env.preprod -- prisma migrate deploy",
    "prisma:migrate:prod": "dotenv -e .env.prod -- prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:studio:preprod": "dotenv -e .env.preprod -- prisma studio",
    "prisma:studio:prod": "dotenv -e .env.prod -- prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:reset": "npx prisma migrate reset --force",
    "db:up": "docker compose -f config/docker-compose.yml up -d",
    "db:down": "docker compose -f config/docker-compose.yml down",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --watch --runInBand",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --runInBand",
    "test:verbose": "cross-env NODE_ENV=test jest --verbose --runInBand",
    "test:auth": "cross-env NODE_ENV=test jest tests/routes/auth.test.js --runInBand",
    "test:android": "cross-env NODE_ENV=test jest tests/routes/android.test.js --runInBand",
    "test:banners": "cross-env NODE_ENV=test jest tests/routes/banners.test.js --runInBand",
    "test:checkIn": "cross-env NODE_ENV=test jest tests/routes/checkIn.test.js --runInBand",
    "test:gyms": "cross-env NODE_ENV=test jest tests/routes/gyms.test.js --runInBand",
    "test:members": "cross-env NODE_ENV=test jest tests/routes/members.test.js --runInBand",
    "test:plannings": "cross-env NODE_ENV=test jest tests/routes/plannings.test.js --runInBand",
    "test:store": "cross-env NODE_ENV=test jest tests/routes/store.test.js --runInBand",
    "test:subscriptions": "cross-env NODE_ENV=test jest tests/routes/subscriptions.test.js --runInBand",
    "test:subscriptionTypes": "cross-env NODE_ENV=test jest tests/routes/subscriptionTypes.test.js --runInBand",
    "test:users": "cross-env NODE_ENV=test jest tests/routes/users.test.js --runInBand",
    "test:emailService": "cross-env NODE_ENV=test jest tests/services/emailService.test.js --runInBand",
    "test:ci": "cross-env NODE_ENV=test jest --ci --coverage --maxWorkers=2",
    "test:legacy": "node tests/unit/test-api-quick.js",
    "test:payment": "node tests/unit/test-acknowledge-olivia.js",
    "test:planning-notif": "node scripts/dev/test-daily-planning-notification.js",
    "test:full": "./tests/integration/run-full-test.sh",
    "tunnel": "./bin/start-tunnel.sh",
    "check:swagger": "node scripts/maintenance/check-swagger.js",
    "check:codes": "node scripts/maintenance/check-unique-codes.js",
    "pm2:restart:preprod": "npx prisma generate && pm2 restart teamfitness-preprod"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.6.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.10",
    "prisma": "^6.19.0",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.18.3",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.2.0",
    "jest-mock-extended": "^4.0.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  }
}
