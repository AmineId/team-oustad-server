generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Rôles V2 : coach créé par l'owner, rattaché à une ou plusieurs salles
/// (CoachGym). `User.gymId` = sa salle principale ; la source de vérité est CoachGym.
model Coach {
  userId   Int        @id
  User     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  CoachGym CoachGym[]
}

model CoachGym {
  coachId   Int
  gymId     Int
  createdAt DateTime @default(now())
  Coach     Coach    @relation(fields: [coachId], references: [userId], onDelete: Cascade)
  Gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@id([coachId, gymId])
  @@index([gymId])
}

/// Ancien rôle `admin` (renommé en Rôles V2). Gère une seule salle (`User.gymId`).
model Manager {
  userId Int  @id
  User   User @relation(fields: [userId], references: [id])
}

model Exercise {
  id               Int                @id @default(autoincrement())
  name             String
  description      String?
  category         String
  muscleGroup      String[]
  equipment        String[]
  difficulty       String
  instructions     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  displayId        String             @unique
  PlanningExercise PlanningExercise[]
  ProgramExercise  ProgramExercise[]

  @@index([category])
  @@index([difficulty])
}

model Gym {
  id              Int               @id @default(autoincrement())
  name            String
  address         String
  createdAt       DateTime          @default(now())
  phone           String?
  updatedAt       DateTime          @updatedAt
  image           Bytes?
  displayId       String            @unique
  isPublished     Boolean           @default(false)
  slug            String?           @unique
  description     String?           @db.Text
  OpeningHour     OpeningHour[]
  User            User[]
  Banner          Banner[]
  GymCheckIn      GymCheckIn[]
  StoreProduct    StoreProduct[]
  GymPhoto        GymPhoto[]
  ShowcasePage    ShowcasePage?
  CoachGym        CoachGym[]
  TrainingSession TrainingSession[]
  Incident        Incident[]
  AuditLogs       AuditLog[]

  @@index([name])
  @@index([isPublished])
  @@index([slug])
}

model GymPhoto {
  id        Int      @id @default(autoincrement())
  gymId     Int
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  imageData String   @db.Text
  position  Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([gymId])
  @@index([gymId, position])
}

/// Page du site vitrine éditable depuis l'app (CMS) : `key` = "home" pour
/// la page d'accueil, "gym:<id>" pour la fiche d'une salle. `content` est la
/// page telle qu'envoyée par l'app : { hero?, sections: [...] }.
model ShowcasePage {
  key       String   @id
  gymId     Int?     @unique
  gym       Gym?     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  content   Json
  updatedAt DateTime @updatedAt
  updatedBy Int?
}

model Member {
  joinedAt                    DateTime                @default(now())
  userId                      Int                     @id
  birthDate                   DateTime?
  phone                       String?
  profession                  String?
  fitnessLevel                String?
  onboarding                  Boolean                 @default(true)
  preferredTrainingDays       Int[]                   @default([])
  workoutNotificationsEnabled Boolean                 @default(true)
  /// Coach principal du membre (Rôles V2), rattaché à la salle du membre
  coachId                     Int?
  User                        User                    @relation("MemberProfile", fields: [userId], references: [id])
  Coach                       User?                   @relation("MemberCoach", fields: [coachId], references: [id], onDelete: SetNull)
  MemberGoal                  MemberGoal[]
  MemberMeasurement           MemberMeasurement[]
  Payment                     Payment[]
  Planning                    Planning[]
  ProgramAssignment           ProgramAssignment[]
  TrainingSessionMember       TrainingSessionMember[]
  Subscription                Subscription[]
  GymCheckIn                  GymCheckIn[]
  StoreReservation            StoreReservation[]

  @@index([coachId])
}

model MemberGoal {
  id           Int       @id @default(autoincrement())
  displayId    String    @unique
  memberId     Int
  title        String
  description  String?
  targetDate   DateTime?
  startWeight  Float?
  targetWeight Float?
  startWaist   Float?
  targetWaist  Float?
  status       String    @default("active")
  achievedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  Member       Member    @relation(fields: [memberId], references: [userId], onDelete: Cascade)

  @@index([memberId])
  @@index([status])
}

model MemberMeasurement {
  id         Int      @id @default(autoincrement())
  displayId  String   @unique
  memberId   Int
  weight     Float?
  waist      Float?
  chest      Float?
  hips       Float?
  thigh      Float?
  arm        Float?
  bodyFat    Float?
  muscleMass Float?
  notes      String?
  measuredBy Int?
  measuredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Member     Member   @relation(fields: [memberId], references: [userId], onDelete: Cascade)

  @@index([memberId, measuredAt])
}

model OpeningHour {
  id        Int      @id @default(autoincrement())
  gymId     Int
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, dayOfWeek])
}

model Owner {
  userId          Int     @id
  canManageAdmins Boolean @default(true)
  canManageGyms   Boolean @default(true)
  canViewReports  Boolean @default(true)
  maxGymsAllowed  Int     @default(5)
  /// Seul le super-owner voit l'historique (AuditLog) et ne peut être ni
  /// modifié ni supprimé par un autre owner. Attribué par script, pas par l'API.
  isSuperOwner    Boolean @default(false)
  User            User    @relation(fields: [userId], references: [id])
}

/// Historique des écritures en base (qui, quoi, quand), rempli par
/// l'extension Prisma de utils/audit.js. Lecture réservée au super-owner.
model AuditLog {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now())
  /// create | update | delete
  action          String
  /// Nom du modèle Prisma (User, Subscription…)
  entity          String
  /// Clé primaire de la ligne (valeurs jointes par ":" si composite)
  entityId        String?
  entityDisplayId String?
  label           String?
  gymId           Int?
  /// null = système (tâche planifiée, requête non authentifiée)
  actorId         Int?
  actorRole       String?
  /// Nom de l'auteur figé au moment de l'action
  actorLabel      String
  /// "PUT /users/USR-42" ou "cron:dailyPaymentCheck"
  source          String?
  /// { champ: { from, to } } ; champs sensibles masqués
  changes         Json
  Actor           User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  Gym             Gym?     @relation(fields: [gymId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([gymId, createdAt])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    Int
  User      User     @relation(fields: [userId], references: [id])
}

model Payment {
  id             Int           @id @default(autoincrement())
  memberId       Int
  amount         Float
  currency       String        @default("MAD")
  status         String
  type           String
  paymentMethod  String?
  transactionId  String?       @unique
  description    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subscriptionId Int?
  dueDate        DateTime      @default(now())
  monthNumber    Int?
  paidAt         DateTime?
  displayId      String        @unique
  Member         Member        @relation(fields: [memberId], references: [userId])
  Subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([memberId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
  @@index([memberId, status])
}

model Planning {
  id          Int           @id @default(autoincrement())
  memberId    Int
  coachId     Int
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      String        @default("active")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  displayId   String        @unique
  User        User          @relation(fields: [coachId], references: [id])
  Member      Member        @relation(fields: [memberId], references: [userId])
  PlanningDay PlanningDay[]

  @@index([memberId])
  @@index([coachId])
  @@index([status])
  @@index([startDate, endDate])
}

/// Rôles V2 : programme réutilisable créé par l'owner (jours + exercices),
/// affecté ensuite aux membres via ProgramAssignment. Remplace Planning.
model Program {
  id                Int                 @id @default(autoincrement())
  displayId         String              @unique
  title             String
  description       String?
  level             String?
  durationWeeks     Int?
  createdBy         Int?
  /// Planning d'origine (migration Rôles V2)
  sourcePlanningId  Int?                @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  Creator           User?               @relation("ProgramCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  ProgramDay        ProgramDay[]
  ProgramAssignment ProgramAssignment[]

  @@index([title])
}

model ProgramDay {
  id              Int               @id @default(autoincrement())
  programId       Int
  dayOfWeek       Int
  Program         Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  ProgramExercise ProgramExercise[]

  @@unique([programId, dayOfWeek])
}

model ProgramExercise {
  id           Int        @id @default(autoincrement())
  programDayId Int
  exerciseId   Int
  sets         Int?
  reps         Int?
  duration     Int?
  weight       Float?
  restTime     Int?
  notes        String?
  order        Int        @default(0)
  ProgramDay   ProgramDay @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  Exercise     Exercise   @relation(fields: [exerciseId], references: [id])

  @@index([programDayId, order])
}

/// Affectation d'un programme à un membre. Un membre a au plus une
/// affectation `active` à la fois (les précédentes passent en `completed`).
model ProgramAssignment {
  id               Int       @id @default(autoincrement())
  displayId        String    @unique
  programId        Int
  memberId         Int
  assignedBy       Int?
  startDate        DateTime
  endDate          DateTime?
  status           String    @default("active") // active, completed, cancelled
  sourcePlanningId Int?      @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  Program          Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  Member           Member    @relation(fields: [memberId], references: [userId], onDelete: Cascade)
  Assigner         User?     @relation("ProgramAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@index([memberId, status])
  @@index([programId, status])
}

/// Rôles V2 : séance = plage de travail d'un coach dans une salle, avec un
/// ou plusieurs membres. Nommée TrainingSession pour ne pas confondre avec
/// la session d'auth (currentSessionId) ni le quota d'abonnement (sessionsUsed).
model TrainingSession {
  id             Int                     @id @default(autoincrement())
  displayId      String                  @unique
  gymId          Int
  coachId        Int
  startAt        DateTime
  endAt          DateTime
  capacity       Int                     @default(1)
  title          String?
  /// discovery, training, group_class, assessment, private
  type           String                  @default("training")
  notes          String?
  /// Série hebdomadaire (même valeur pour toutes les occurrences)
  seriesId       String?
  status         String                  @default("scheduled") // scheduled, done, cancelled
  createdBy      Int?
  reminderSentAt DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  Gym            Gym                     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  Coach          User                    @relation("SessionCoach", fields: [coachId], references: [id], onDelete: Cascade)
  Creator        User?                   @relation("SessionCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  Members        TrainingSessionMember[]

  @@index([gymId, startAt])
  @@index([gymId, type, startAt])
  @@index([coachId, startAt])
  @@index([seriesId])
  @@index([status, startAt])
}

model TrainingSessionMember {
  sessionId    Int
  memberId     Int
  status       String          @default("booked") // booked, checked_in, absent, cancelled
  bookedAt     DateTime        @default(now())
  checkedInAt  DateTime?
  checkedInBy  Int?
  gymCheckInId Int?
  Session      TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  Member       Member          @relation(fields: [memberId], references: [userId], onDelete: Cascade)

  @@id([sessionId, memberId])
  @@index([memberId])
}

/// Rôles V2 : incident signalé par un manager (app ou kiosk) ou un coach
/// (app) ; l'owner répond et change le statut.
model Incident {
  id          Int               @id @default(autoincrement())
  displayId   String            @unique
  gymId       Int
  createdBy   Int
  creatorRole String
  source      String            @default("app") // app, kiosk
  title       String
  description String            @db.Text
  category    String // equipment, safety, hygiene, member, other
  severity    String // low, medium, high, critical
  photo       Bytes?
  photoMime   String?
  status      String            @default("open") // open, in_progress, resolved, closed
  closedAt    DateTime?
  closedBy    Int?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  Gym         Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  Creator     User              @relation("IncidentCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  Closer      User?             @relation("IncidentCloser", fields: [closedBy], references: [id], onDelete: SetNull)
  Messages    IncidentMessage[]
  Reads       IncidentRead[]

  @@index([gymId, status])
  @@index([createdBy])
  @@index([status, createdAt])
}

model IncidentMessage {
  id         Int      @id @default(autoincrement())
  incidentId Int
  authorId   Int
  body       String   @db.Text
  createdAt  DateTime @default(now())
  Incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  Author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

/// Chat d'incident : dernier message lu par utilisateur (calcul de unreadCount)
model IncidentRead {
  incidentId        Int
  userId            Int
  lastReadMessageId Int
  readAt            DateTime @default(now())
  Incident          Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  User              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([incidentId, userId])
  @@index([userId])
}

model PlanningDay {
  id               Int                @id @default(autoincrement())
  planningId       Int
  dayOfWeek        Int
  Planning         Planning           @relation(fields: [planningId], references: [id], onDelete: Cascade)
  PlanningExercise PlanningExercise[]

  @@unique([planningId, dayOfWeek])
}

model PlanningExercise {
  id            Int         @id @default(autoincrement())
  exerciseId    Int
  sets          Int?
  reps          Int?
  duration      Int?
  weight        Float?
  restTime      Int?
  notes         String?
  order         Int         @default(0)
  planningDayId Int
  Exercise      Exercise    @relation(fields: [exerciseId], references: [id])
  PlanningDay   PlanningDay @relation(fields: [planningDayId], references: [id], onDelete: Cascade)

  @@unique([planningDayId, exerciseId, order])
}

model Subscription {
  id                 Int                 @id @default(autoincrement())
  memberId           Int
  status             String
  startDate          DateTime
  endDate            DateTime?
  autoRenew          Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  subscriptionTypeId Int
  paymentFrequency   Int                 @default(12)
  displayId          String              @unique
  sessionsUsed       Int                 @default(0) // Séances consommées
  sessionQuota       Int? // Quota copié du SubscriptionType au moment de la création
  Payment            Payment[]
  GymCheckIn         GymCheckIn[]
  QuotaNotification  QuotaNotification[]
  Member             Member              @relation(fields: [memberId], references: [userId])
  SubscriptionType   SubscriptionType    @relation(fields: [subscriptionTypeId], references: [id])

  @@index([memberId])
  @@index([status])
  @@index([subscriptionTypeId])
  @@index([startDate, endDate])
  @@index([memberId, status])
}

model SubscriptionType {
  id             Int            @id @default(autoincrement())
  name           String         @unique
  description    String?
  monthlyPrice   Float
  features       String[]
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  displayId      String         @unique
  sessionQuota   Int? // Nombre de séances (12, 18, 36, null=illimité)
  sessionType    String         @default("unlimited") // "limited" ou "unlimited"
  durationMonths Int            @default(1) // Durée en mois (1 mois pour quotas, 12 pour annuel)
  Subscription   Subscription[]

  @@index([isActive])
  @@index([name])
  @@index([sessionType])
}

model User {
  id                   Int                  @id @default(autoincrement())
  email                String               @unique
  password             String
  firstName            String
  lastName             String
  role                 String
  gymId                Int
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  uniqueCode           String               @unique
  qrCode               Bytes?
  profileImage         Bytes?
  fcmToken             String?
  displayId            String               @unique
  lastLoginAt          DateTime?
  notificationsEnabled Boolean              @default(true)
  phoneNumber          String?              @unique
  address              String?
  currentSessionId     String?
  /// Session kiosk distincte de la session app (une connexion kiosk ne
  /// déconnecte pas le téléphone du manager, et inversement)
  kioskSessionId       String?
  Manager              Manager?
  Coach                Coach?
  Member               Member?              @relation("MemberProfile")
  CoachedMembers       Member[]             @relation("MemberCoach")
  Owner                Owner?
  PasswordResetToken   PasswordResetToken[]
  Planning             Planning[]
  CreatedPrograms      Program[]            @relation("ProgramCreator")
  AssignedPrograms     ProgramAssignment[]  @relation("ProgramAssigner")
  CoachedSessions      TrainingSession[]    @relation("SessionCoach")
  CreatedSessions      TrainingSession[]    @relation("SessionCreator")
  CreatedIncidents     Incident[]           @relation("IncidentCreator")
  ClosedIncidents      Incident[]           @relation("IncidentCloser")
  IncidentMessages     IncidentMessage[]
  IncidentReads        IncidentRead[]
  StoreProduct         StoreProduct[]
  AuditLogs            AuditLog[]           @relation("AuditActor")
  Gym                  Gym                  @relation(fields: [gymId], references: [id])

  @@index([gymId])
  @@index([role])
  @@index([gymId, role])
  @@index([lastLoginAt])
}

model Banner {
  id                Int             @id @default(autoincrement())
  displayId         String          @unique
  title             String
  titleEn           String?
  titleAr           String?
  description       String?
  descriptionEn     String?
  descriptionAr     String?
  imageUrl          String?
  imageBase64       String?         @db.Text
  videoUrl          String?
  mediaType         String          @default("image") // image, video, gif
  type              String // seasonal, event, promotion, info, announcement
  startDate         DateTime
  endDate           DateTime
  actionType        String          @default("none") // navigate, externalUrl, showDetails, none
  actionData        String?
  actionParams      Json?
  priority          Int             @default(0)
  isActive          Boolean         @default(true)
  gymId             Int?
  backgroundColor   String?
  textColor         String?
  maxViewsPerUser   Int? // Limite d'affichage par utilisateur
  isScheduled       Boolean         @default(true) // Auto-activation selon dates
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  Gym               Gym?            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  BannerStats       BannerStats[]
  BannerVariant     BannerVariant[]
  subscriptionTypes Int[] // IDs des types d'abonnement ciblés (vide = tous)

  @@index([isActive, startDate, endDate])
  @@index([gymId])
  @@index([type])
  @@index([priority])
}

model BannerVariant {
  id              Int           @id @default(autoincrement())
  displayId       String        @unique
  bannerId        Int
  variantName     String // A, B, C...
  title           String
  titleEn         String?
  titleAr         String?
  description     String?
  descriptionEn   String?
  descriptionAr   String?
  imageUrl        String?
  imageBase64     String?       @db.Text
  videoUrl        String?
  backgroundColor String?
  textColor       String?
  isActive        Boolean       @default(true)
  weight          Int           @default(50) // % de distribution du trafic
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  Banner          Banner        @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  BannerStats     BannerStats[]

  @@unique([bannerId, variantName])
  @@index([bannerId, isActive])
}

model BannerStats {
  id            Int            @id @default(autoincrement())
  bannerId      Int
  variantId     Int?
  userId        Int? // Pour tracking par utilisateur
  eventType     String // view, click
  viewedAt      DateTime?
  clickedAt     DateTime?
  userAgent     String?
  ipAddress     String?
  createdAt     DateTime       @default(now())
  Banner        Banner         @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  BannerVariant BannerVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([bannerId, eventType])
  @@index([bannerId, userId])
  @@index([variantId, eventType])
  @@index([createdAt])
}

model GymCheckIn {
  id             Int          @id @default(autoincrement())
  displayId      String       @unique
  memberId       Int
  subscriptionId Int
  gymId          Int
  checkInTime    DateTime     @default(now())
  checkOutTime   DateTime? // Auto checkout à minuit
  duration       Int? // Durée en minutes
  isManual       Boolean      @default(false) // Check-in manuel par staff
  createdBy      Int? // ID du staff qui a fait le check-in manuel
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  Member         Member       @relation(fields: [memberId], references: [userId], onDelete: Cascade)
  Subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  Gym            Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([subscriptionId])
  @@index([gymId])
  @@index([checkInTime])
  @@index([memberId, checkInTime])
}

model QuotaNotification {
  id             Int          @id @default(autoincrement())
  subscriptionId Int          @unique
  sentAt         DateTime     @default(now())
  Subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([sentAt])
}

model StoreProduct {
  id               Int                @id @default(autoincrement())
  displayId        String             @unique
  name             String
  description      String?
  imagesBase64     String[]           @default([])
  price            Float
  stock            Int                @default(0)
  reservedStock    Int                @default(0) // Stock réservé (en attente de retrait)
  availableStock   Int                @default(0) // Stock disponible (calculé: stock - reservedStock)
  isActive         Boolean            @default(true)
  category         String?
  gymId            Int
  createdBy        Int
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  Gym              Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)
  Creator          User               @relation(fields: [createdBy], references: [id])
  StoreReservation StoreReservation[]

  @@index([gymId])
  @@index([isActive])
  @@index([category])
  @@index([createdBy])
}

model StoreReservation {
  id          Int          @id @default(autoincrement())
  displayId   String       @unique
  productId   Int
  memberId    Int
  quantity    Int          @default(1)
  totalPrice  Float
  status      String       @default("pending") // pending, completed, cancelled
  reservedAt  DateTime     @default(now())
  completedAt DateTime? // Date de retrait
  cancelledAt DateTime?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  Product     StoreProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  Member      Member       @relation(fields: [memberId], references: [userId], onDelete: Cascade)

  @@index([productId])
  @@index([memberId])
  @@index([status])
  @@index([reservedAt])
}
