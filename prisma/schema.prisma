generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  userId Int  @id
  User   User @relation(fields: [userId], references: [id])
}

model Exercise {
  id               Int                @id @default(autoincrement())
  name             String
  description      String?
  category         String
  muscleGroup      String[]
  equipment        String[]
  difficulty       String
  instructions     String?
  createdAt        DateTime           @default(now())
  updatedAt            DateTime @updatedAt
  displayId        String             @unique
  PlanningExercise PlanningExercise[]

  @@index([category])
  @@index([difficulty])
}

model Gym {
  id          Int           @id @default(autoincrement())
  name        String
  address     String
  createdAt   DateTime      @default(now())
  phone       String?
  updatedAt   DateTime      @updatedAt
  image       Bytes?
  displayId   String        @unique
  OpeningHour OpeningHour[]
  User        User[]

  @@index([name])
}

model Member {
  joinedAt                    DateTime            @default(now())
  userId                      Int                 @id
  uniqueCode                  String              @unique
  birthDate                   DateTime?
  phone                       String?
  profession                  String?
  fitnessLevel                String?
  onboarding                  Boolean             @default(true)
  preferredTrainingDays       Int[]               @default([])
  workoutNotificationsEnabled Boolean             @default(true)
  User                        User                @relation(fields: [userId], references: [id])
  MemberGoal                  MemberGoal[]
  MemberMeasurement           MemberMeasurement[]
  Payment                     Payment[]
  Planning                    Planning[]
  Subscription                Subscription[]
}

model MemberGoal {
  id           Int       @id @default(autoincrement())
  displayId    String    @unique
  memberId     Int
  title        String
  description  String?
  targetDate   DateTime?
  startWeight  Float?
  targetWeight Float?
  startWaist   Float?
  targetWaist  Float?
  status       String    @default("active")
  achievedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt            DateTime @updatedAt
  Member       Member    @relation(fields: [memberId], references: [userId], onDelete: Cascade)

  @@index([memberId])
  @@index([status])
}

model MemberMeasurement {
  id         Int      @id @default(autoincrement())
  displayId  String   @unique
  memberId   Int
  weight     Float?
  waist      Float?
  chest      Float?
  hips       Float?
  thigh      Float?
  arm        Float?
  bodyFat    Float?
  muscleMass Float?
  notes      String?
  measuredBy Int?
  measuredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt            DateTime @updatedAt
  Member     Member   @relation(fields: [memberId], references: [userId], onDelete: Cascade)

  @@index([memberId, measuredAt])
}

model OpeningHour {
  id        Int      @id @default(autoincrement())
  gymId     Int
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt            DateTime @updatedAt
  Gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, dayOfWeek])
}

model Owner {
  userId          Int     @id
  canManageAdmins Boolean @default(true)
  canManageGyms   Boolean @default(true)
  canViewReports  Boolean @default(true)
  maxGymsAllowed  Int     @default(5)
  User            User    @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    Int
  User      User     @relation(fields: [userId], references: [id])
}

model Payment {
  id             Int           @id @default(autoincrement())
  memberId       Int
  amount         Float
  currency       String        @default("EUR")
  status         String
  type           String
  paymentMethod  String?
  transactionId  String?       @unique
  description    String?
  createdAt      DateTime      @default(now())
  updatedAt            DateTime @updatedAt
  subscriptionId Int?
  dueDate        DateTime      @default(now())
  monthNumber    Int?
  paidAt         DateTime?
  displayId      String        @unique
  Member         Member        @relation(fields: [memberId], references: [userId])
  Subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([memberId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
  @@index([memberId, status])
}

model Planning {
  id          Int           @id @default(autoincrement())
  memberId    Int
  coachId     Int
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      String        @default("active")
  createdAt   DateTime      @default(now())
  updatedAt            DateTime @updatedAt
  displayId   String        @unique
  User        User          @relation(fields: [coachId], references: [id])
  Member      Member        @relation(fields: [memberId], references: [userId])
  PlanningDay PlanningDay[]

  @@index([memberId])
  @@index([coachId])
  @@index([status])
  @@index([startDate, endDate])
}

model PlanningDay {
  id               Int                @id @default(autoincrement())
  planningId       Int
  dayOfWeek        Int
  Planning         Planning           @relation(fields: [planningId], references: [id], onDelete: Cascade)
  PlanningExercise PlanningExercise[]

  @@unique([planningId, dayOfWeek])
}

model PlanningExercise {
  id            Int         @id @default(autoincrement())
  exerciseId    Int
  sets          Int?
  reps          Int?
  duration      Int?
  weight        Float?
  restTime      Int?
  notes         String?
  order         Int         @default(0)
  planningDayId Int
  Exercise      Exercise    @relation(fields: [exerciseId], references: [id])
  PlanningDay   PlanningDay @relation(fields: [planningDayId], references: [id], onDelete: Cascade)

  @@unique([planningDayId, exerciseId, order])
}

model Subscription {
  id                 Int              @id @default(autoincrement())
  memberId           Int
  status             String
  startDate          DateTime
  endDate            DateTime?
  autoRenew          Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt            DateTime @updatedAt
  subscriptionTypeId Int
  paymentFrequency   Int              @default(12)
  displayId          String           @unique
  Payment            Payment[]
  Member             Member           @relation(fields: [memberId], references: [userId])
  SubscriptionType   SubscriptionType @relation(fields: [subscriptionTypeId], references: [id])

  @@index([memberId])
  @@index([status])
  @@index([subscriptionTypeId])
  @@index([startDate, endDate])
  @@index([memberId, status])
}

model SubscriptionType {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  description  String?
  monthlyPrice Float
  features     String[]
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt            DateTime @updatedAt
  displayId    String         @unique
  Subscription Subscription[]

  @@index([isActive])
  @@index([name])
}

model User {
  id                   Int                  @id @default(autoincrement())
  email                String               @unique
  password             String
  fullName             String
  role                 String
  gymId                Int
  createdAt            DateTime             @default(now())
  updatedAt            DateTime @updatedAt
  uniqueCode           String               @unique
  qrCode               Bytes?
  profileImage         Bytes?
  fcmToken             String?
  displayId            String               @unique
  lastLoginAt          DateTime?
  notificationsEnabled Boolean              @default(true)
  phoneNumber          String?              @unique
  Admin                Admin?
  Member               Member?
  Owner                Owner?
  PasswordResetToken   PasswordResetToken[]
  Planning             Planning[]
  Gym                  Gym                  @relation(fields: [gymId], references: [id])

  @@index([gymId])
  @@index([role])
  @@index([gymId, role])
  @@index([lastLoginAt])
}
